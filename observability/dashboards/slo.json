{
  "title": "SLOs — LLM serving",
  "uid": "llm-slo",
  "tags": ["slo", "llm", "sli"],
  "schemaVersion": 39,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Availability (30d) — target 99.5%",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 5 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "1 - (sum(rate(slo:llm_failed_requests_total[30d])) / sum(rate(slo:llm_total_requests_total[30d])))"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",    "value": null },
              { "color": "yellow", "value": 0.99 },
              { "color": "green",  "value": 0.995 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Error budget remaining (30d)",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 5 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "1 - ((sum(rate(slo:llm_failed_requests_total[30d])) / sum(rate(slo:llm_total_requests_total[30d]))) / 0.005)"
      }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 1 } }
    },
    {
      "type": "stat",
      "title": "Burn rate (1h)",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 5 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "(sum(rate(slo:llm_failed_requests_total[1h])) / sum(rate(slo:llm_total_requests_total[1h]))) / 0.005"
      }],
      "fieldConfig": {
        "defaults": {
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "orange", "value": 6 },
              { "color": "red",    "value": 14.4 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error budget consumption over 30d",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 9 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "1 - ((sum(rate(slo:llm_failed_requests_total[30d])) / sum(rate(slo:llm_total_requests_total[30d]))) / 0.005)",
        "legendFormat": "budget remaining"
      }]
    },
    {
      "type": "timeseries",
      "title": "TTFT p95 vs SLO target (500ms)",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket[5m])))", "legendFormat": "TTFT p95" },
        { "expr": "vector(0.5)", "legendFormat": "SLO target" }
      ]
    },
    {
      "type": "timeseries",
      "title": "End-to-end p95 vs SLO target (8s)",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket[5m])))", "legendFormat": "e2e p95" },
        { "expr": "vector(8)", "legendFormat": "SLO target" }
      ]
    }
  ]
}
