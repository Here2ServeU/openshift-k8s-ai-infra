{
  "title": "LLM Serving — vLLM",
  "uid": "llm-serving",
  "tags": ["llm", "vllm", "serving"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "model",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(vllm:request_success_total, model)",
        "refresh": 2,
        "includeAll": true
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(vllm:request_success_total, namespace)",
        "refresh": 2,
        "current": { "selected": false, "text": "workloads", "value": "workloads" }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "SLI overview",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "type": "stat",
      "title": "Request rate (req/s)",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(vllm:request_success_total{model=~\"$model\",namespace=~\"$namespace\"}[1m]))"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 } }
    },
    {
      "type": "stat",
      "title": "TTFT p95",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{model=~\"$model\"}[5m])))"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 0.3 },
              { "color": "red",    "value": 0.5 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "TPOT p95",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_per_output_token_seconds_bucket{model=~\"$model\"}[5m])))"
      }],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 } }
    },
    {
      "type": "stat",
      "title": "Tokens/sec (output)",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(vllm:generation_tokens_total{model=~\"$model\"}[1m]))"
      }],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "type": "stat",
      "title": "Error rate",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(vllm:request_failure_total{model=~\"$model\"}[5m])) / clamp_min(sum(rate(vllm:request_success_total{model=~\"$model\"}[5m])) + sum(rate(vllm:request_failure_total{model=~\"$model\"}[5m])), 1)"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.005 },
              { "color": "red",   "value": 0.01 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Replicas",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "count(up{job=\"vllm\",model=~\"$model\"} == 1)"
      }]
    },

    {
      "type": "row",
      "title": "Latency",
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }
    },
    {
      "type": "heatmap",
      "title": "TTFT distribution (heatmap)",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{model=~\"$model\"}[1m]))",
        "format": "heatmap",
        "legendFormat": "{{le}}"
      }]
    },
    {
      "type": "timeseries",
      "title": "End-to-end latency percentiles",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket{model=~\"$model\"}[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket{model=~\"$model\"}[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket{model=~\"$model\"}[5m])))", "legendFormat": "p99" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "type": "row",
      "title": "Capacity & saturation",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "Queue depth (waiting) vs in-flight (running)",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(vllm:num_requests_waiting{model=~\"$model\"})", "legendFormat": "waiting" },
        { "expr": "sum(vllm:num_requests_running{model=~\"$model\"})", "legendFormat": "running" }
      ]
    },
    {
      "type": "timeseries",
      "title": "KV cache utilization (%)",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 7 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "max by (pod) (vllm:gpu_cache_usage_perc{model=~\"$model\"} * 100)",
        "legendFormat": "{{pod}}"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red",    "value": 90 }
            ]
          }
        }
      }
    },

    {
      "type": "row",
      "title": "GPU (DCGM)",
      "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "GPU utilization (%)",
      "gridPos": { "x": 0, "y": 23, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "avg by (pod) (DCGM_FI_DEV_GPU_UTIL{pod=~\"vllm-.*\"})",
        "legendFormat": "{{pod}}"
      }],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 } }
    },
    {
      "type": "timeseries",
      "title": "GPU memory used (GiB)",
      "gridPos": { "x": 8, "y": 23, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "avg by (pod) (DCGM_FI_DEV_FB_USED{pod=~\"vllm-.*\"}) / 1024",
        "legendFormat": "{{pod}}"
      }],
      "fieldConfig": { "defaults": { "unit": "decgbytes" } }
    },
    {
      "type": "timeseries",
      "title": "GPU power draw (W)",
      "gridPos": { "x": 16, "y": 23, "w": 8, "h": 7 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "avg by (pod) (DCGM_FI_DEV_POWER_USAGE{pod=~\"vllm-.*\"})",
        "legendFormat": "{{pod}}"
      }],
      "fieldConfig": { "defaults": { "unit": "watt" } }
    },

    {
      "type": "row",
      "title": "Token throughput",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 }
    },
    {
      "type": "timeseries",
      "title": "Prompt vs generation tokens/sec",
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 7 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(vllm:prompt_tokens_total{model=~\"$model\"}[1m]))",     "legendFormat": "prompt" },
        { "expr": "sum(rate(vllm:generation_tokens_total{model=~\"$model\"}[1m]))", "legendFormat": "generation" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Avg batch size (running)",
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 7 },
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(vllm:num_requests_running{model=~\"$model\"}) / count(up{job=\"vllm\",model=~\"$model\"} == 1)"
      }]
    }
  ]
}
